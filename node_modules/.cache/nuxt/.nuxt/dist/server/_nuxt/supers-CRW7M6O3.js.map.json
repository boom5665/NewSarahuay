B,YAAA,UAAW,UAAA,GAAA,WAAA,CAAA,0BAGxBA,cAAA,OA3CJ,UAAiC;YAgDpB,YAAA,UAAW,SAAA;;;;;YA2BX,YAAA,UAAW,UAAA;;;;;YAWX,YAAA,UAAW,WAAA;;;;;;;;;AAkBtB,UAAA,IAAA,uBAAqB,WAAA,OAAU;;;;;UAyB/B,IAAA,UAAG,SAAA;;;;;;;;AAUUD,oBAAA,YAAA,QAAX,YAAO;;UACb,KAAK,QAAQ;AAAA,UACb,MAAM;AAAA,UACN,KAAK;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;mBCtJXG,eAAAC,WAAA,EAAA,OAAM,UAAS,GAAA,MAAA,CAAA,qLAIN,OAAK,QAAA,IAAI,MAAM,iKAKQF,eAAA,QAAA,IAAI,QAAQ,+DAOxCA,eAAA,QAAA,IAAI,IAAI,wCAA0BA,eAAA,QAAA,IAAI,IAAI;;;;;;;;;;;;;;;ACuDrD,UAAM,YAAY,IAAI,OAAO;AAE7B,UAAM,YAAY;AAAA,MAChB,EAAE,KAAK,SAAS,OAAO,SAAQ;AAAA,MAC/B,EAAE,KAAK,WAAW,OAAO,WAAU;AAAA,MACnC,EAAE,KAAK,QAAQ,OAAO,SAAQ;AAAA,MAC9B,EAAE,KAAK,SAAS,OAAO,UAAS;AAAA,MAChC,EAAE,KAAK,QAAQ,OAAO,UAAS;AAAA,MAC/B,EAAE,KAAK,QAAQ,OAAO,SAAQ;AAAA,MAC9B,EAAE,KAAK,UAAU,OAAO,SAAQ;AAAA,MAChC,EAAE,KAAK,SAAS,OAAO,WAAU;AAAA,IACnC;AAEA,UAAM,eAAe;AAAA,MACnB,OAAO;AAAA,QACL,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,SAAS;AAAA,QACP,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,MAAM;AAAA,QACJ,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,OAAO;AAAA,QACL,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,MAAM;AAAA,QACJ,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,MAAM;AAAA,QACJ,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,QAAQ;AAAA,QACN,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,MACE,OAAO;AAAA,QACL,OAAO;AAAA,QACP,KAAK;AAAA,MACT;AAAA,IACA;AAEA,UAAM,iBAAiB,SAAS,MAAM,aAAa,UAAU,KAAK,CAAC;AACnE,UAAM,aAAa,IAAI,KAAK;;;WAvHQ,WAAA,OAAU;;AAQrBF,sBAAA,YAAR,SAAI;yDAGO,UAAA,UAAc,KAAK,IAAG,GAAA,WAAA,CAAA,0BAGnCC,cAAA,OAAA,UAAiC,2CAC7BC,eAAA,KAAK,KAAK;;mHAKhBA,eAAA,eAAA,MAAe,KAAK,kDAIpBA,eAAA,eAAA,MAAe,GAAG;;;;UAgBK,WAAA,OAAU;;;;;;;;;;;;;;;;;;;;ACuH9C,UAAM,cAAc,IAAI;AAAA,MACtB;AAAA,QACE,IAAI;AAAA,QACJ,QAAQ;AAAA,QACR,UACE;AAAA,QACF,MAAM;AAAA,QACN,MAAM;AAAA,MACV;AAAA,MACE;AAAA,QACE,IAAI;AAAA,QACJ,QAAQ;AAAA,QACR,UACE;AAAA,QACF,MAAM;AAAA,QACN,MAAM;AAAA,MACV;AAAA,MACE;AAAA,QACE,IAAI;AAAA,QACJ,QAAQ;AAAA,QACR,UAAU;AAAA,QACV,MAAM;AAAA,QACN,MAAM;AAAA,MACV;AAAA,MACE;AAAA,QACE,IAAI;AAAA,QACJ,QAAQ;AAAA,QACR,UAAU;AAAA,QACV,MAAM;AAAA,QACN,MAAM;AAAA,MACV;AAAA,IACA,CAAC;AAED,UAAM,MAAM,IAAI,SAAS;AACzB,UAAM,cAAc,IAAI,OAAO;AAE/B,UAAM,aAAa,IAAI,KAAK;;mBApMrBC,eAAAC,WAAA,EAAA,OAAM,eAAc,GAAA,MAAA,CAAA,uIAKC,IAAA,UAAG,UAAA,GAAA,KAAA,CAAA,0BAGhBH,cAAA,OAAA,UAAiC,wEAKpB,IAAA,UAAG,QAAA,GAAA,KAAA,CAAA,0BAGhBA,cAAA,OARA,UAAiC;AAY9B,UAAA,IAAA,wBAAsB,WAAA,OAAU;ySASlB,YAAA,UAAW,QAAA,GAAA,WAAA,CAAA,0BAGxBA,cAAA,OAxBJ,UAAiC,yEA8BhB,YAAA,UAAW,SAAA,GAAA,WAAA,CAAA,0BAGxBA,cAAA,OAjCJ,UAAiC,6EAuChB,YAAA,UAAW,UAAA,GAAA,WAAA,CAAA,0BAGxBA,cAAA,OA1CJ,UAAiC;YA+CpB,YAAA,UAAW,SAAA;;;;;YA2BX,YAAA,UAAW,UAAA;;;;;YAWX,YAAA,UAAW,WAAA;;;;;;;;;AAkBtB,UAAA,IAAA,uBAAqB,WAAA,OAAU;;;;;UAwB/B,IAAA,UAAG,SAAA;;;;;;;;AAUUD,oBAAA,YAAA,QAAX,YAAO;;UACb,KAAK,QAAQ;AAAA,UACb,MAAM;AAAA,UACN,KAAK;AAAA;;;;;;;;;;;;;;;;;ACpIlB,UAAM,YAAY,aAAY;AAC9B,UAAM,eAAe,SAAS,MAAM,UAAU,YAAY;;;UAf3CK,MAAA,YAAA,MAAY,UAAA;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderList","_ssrRenderAttr","_ssrInterpolate","_ssrRenderAttrs","_mergeProps","_unref"],"sources":["../../../../../../../components/desktop/Tarot.vue","../../../../../../../components/desktop/supers/Supers.vue","../../../../../../../components/mobile/ImageCard.vue","../../../../../../../components/mobile/Tarot.vue","../../../../../../../components/mobile/supers/Supers.vue","../../../../../../../pages/supers.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"tarot-page\" v-if=\"!showResult\">\n      <div class=\"tarot-title\">\n        ดูดวงไพ่ยิปซี\n        <div class=\"sub\">เลือกสำรับที่ต้องการดู</div>\n      </div>\n\n      <div class=\"tarot-typepc\">\n        <div\n          v-for=\"item in tarotMenu\"\n          :key=\"item.key\"\n          class=\"type-card\"\n          :class=\"{ active: tarotType === item.key }\"\n          @click=\"tarotType = item.key\"\n        >\n          <img src=\"/assets/icons/fi_145802.svg\" />\n          <span>{{ item.label }}</span>\n        </div>\n      </div>\n      <div class=\"tarot-result\">\n        <div class=\"result-title\">\n          {{ currentContent.title }}\n        </div>\n\n        <div class=\"result-sub\">\n          {{ currentContent.sub }}\n        </div>\n\n        <!-- card preview -->\n        <div class=\"card-preview\">\n          <div class=\"card-slot\"  @click=\"predict\"></div>\n        </div>\n\n        <!-- buttons -->\n        <div class=\"draw-action\">\n          <button class=\"btn\" >สับไพ่</button>\n          <button class=\"btn\">จั่วไพ่</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"result-page\" v-if=\"showResult\">\n      <div class=\"result-box\">\n        <div class=\"back-btn\" @click=\"goBack\">← ย้อนกลับ</div>\n\n        <div class=\"result-header\">\n          ชื่อ-สกุล : สมชาย มีทรัพย์\n          <br />\n          เกิดวันที่ 20 พฤศจิกายน 2533 เวลา 09:00\n        </div>\n\n        <div class=\"result-content\">\n          <h3>คำทำนายดวง</h3>\n\n          <p>\n            ไพ่ที่คุณได้คือ ไพ่ฤาษี เป็นไพ่แห่งสติปัญญา\n            ช่วงนี้เหมาะกับการวางแผนชีวิตและใช้เหตุผล\n          </p>\n\n          <h3>คำแนะนำการดำเนินชีวิต</h3>\n\n          <p>ช่วงนี้ควรใช้ความรอบคอบและอย่าตัดสินใจเร็วเกินไป</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\n\nconst tarotType = ref(\"daily\");\n\nconst tarotMenu = [\n  { key: \"daily\", label: \"รายวัน\" },\n  { key: \"monthly\", label: \"รายเดือน\" },\n  { key: \"work\", label: \"การงาน\" },\n  { key: \"money\", label: \"การเงิน\" },\n  { key: \"love\", label: \"ความรัก\" },\n  { key: \"luck\", label: \"โชคลาภ\" },\n  { key: \"health\", label: \"สุขภาพ\" },\n  { key: \"study\", label: \"การเรียน\" }\n];\n\nconst tarotContent = {\n  daily: {\n    title: \"ดูดวงไพ่ยิปซี รายวัน\",\n    sub: 'เลือกไพ่ 1 ใบ เพื่อเปิดคำทำนาย \"ทำนองของดวง\"'\n  },\n  monthly: {\n    title: \"ดูดวงไพ่ยิปซี รายเดือน\",\n    sub: \"ดูแนวโน้มชีวิตของคุณในเดือนนี้\"\n  },\n  work: {\n    title: \"ดูดวงการงาน\",\n    sub: \"ไพ่จะบอกทิศทางเรื่องงานของคุณ\"\n  },\n  money: {\n    title: \"ดูดวงการเงิน\",\n    sub: \"แนวโน้มรายรับรายจ่าย\"\n  },\n  love: {\n    title: \"ดูดวงความรัก\",\n    sub: \"สถานะความสัมพันธ์ของคุณ\"\n  },\n  luck: {\n    title: \"ดูดวงโชคลาภ\",\n    sub: \"โอกาสและดวงเสี่ยงโชค\"\n  },\n  health: {\n    title: \"ดูดวงสุขภาพ\",\n    sub: \"แนวโน้มสุขภาพช่วงนี้\"\n  },\n  study: {\n    title: \"ดูดวงการเรียน\",\n    sub: \"แนวโน้มด้านการศึกษา\"\n  }\n};\n\nconst currentContent = computed(() => tarotContent[tarotType.value]);\n\nconst showResult = ref(false);\n\nconst predict = () => {\n  showResult.value = true;\n};\n\nconst goBack = () => {\n  showResult.value = false;\n};\n\n</script>\n\n<style scoped lang=\"scss\">\n.tarot-page {\n  background: #efefef;\n  padding: 1.5rem;\n  border-radius: 0.6rem;\n}\n\n/* title */\n\n.tarot-title {\n  text-align: center;\n  font-weight: 700;\n  font-size: 1.2rem;\n}\n\n.sub {\n  font-size: 0.8rem;\n  color: #666;\n  margin-top: 0.2rem;\n}\n\n/* grid card */\n\n.tarot-typepc {\n  display: grid;\n  grid-template-columns: repeat(8, 1fr);\n  gap: 0.5rem;\n  margin-top: 1rem;\n}\n\n/* card */\n\n.type-card {\n  background: #ddd;\n  border-radius: 0.5rem;\n  padding: 0.6rem;\n  text-align: center;\n  cursor: pointer;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 0.25rem;\n\n  font-size: 0.8rem;\n}\n\n.type-card img {\n  width: 28px;\n  height: 28px;\n  opacity: 0.7;\n}\n\n/* active */\n\n.type-card.active {\n  background: #cfcfcf;\n  border: 1px solid #888;\n}\n\n.tarot-result {\n  margin-top: 1rem;\n  text-align: center;\n}\n\n.result-title {\n  font-weight: 700;\n}\n\n.result-sub {\n  font-size: 0.8rem;\n  color: #666;\n}\n\n.card-preview {\n  background: #cfcfcf;\n  height: 120px;\n  border-radius: 0.5rem;\n  margin: 0.8rem 0;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.card-slot {\n  width: 70px;\n  height: 100px;\n  border: 2px dashed #999;\n  border-radius: 0.4rem;\n}\n\n.draw-action {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.5rem;\n}\n\n.btn {\n  background: black;\n  color: white;\n  border: none;\n  padding: 0.6rem;\n  border-radius: 0.3rem;\n  cursor: pointer;\n}\n.predict-btn {\n  margin-top: 1rem;\n  background: black;\n  color: white;\n  padding: 0.6rem 1rem;\n  border: none;\n  border-radius: 6px;\n}\n\n.result-page {\n  margin-top: 1rem;\n}\n\n.back-btn {\n  cursor: pointer;\n  margin-bottom: 10px;\n}\n\n.result-box {\n  background: #eee;\n  padding: 0.5rem;\n  border-radius: 0.5rem;\n}\n\n.result-header {\n  background: white;\n  padding: 0.5rem;\n  border-radius: 0.375rem;\n  margin-bottom: 0.625rem;\n}\n\n.result-content {\n  background: white;\n  padding: 0.5rem;\n  border-radius: 0.375rem;\n}\n</style>\n","<template>\n  <div class=\"home-content\">\n    <div class=\"home-box\">\n      <div class=\"tab-menu\">\n        <div\n          class=\"tab\"\n          :class=\"{ active: tab === 'fortune' }\"\n          @click=\"tab = 'fortune'\"\n        >\n          <img src=\"/assets/icons/fi_145802.svg\" />\n          ดูดวง\n        </div>\n        <div\n          class=\"tab\"\n          :class=\"{ active: tab === 'tarot' }\"\n          @click=\"tab = 'tarot'\"\n        >\n          <img src=\"/assets/icons/fi_145802.svg\" />\n          ไพ่ยิปซี\n        </div>\n      </div>\n\n      <div v-if=\"tab === 'fortune' && !showResult\">\n        <div class=\"fortune-box\">\n          <div class=\"section-title\">\n            ทำนายดวงของคุณช่วงนี้\n            <div class=\"sub-title\">เลือกหมวดที่ต้องการดู</div>\n          </div>\n          <div class=\"fortune-type\">\n            <div\n              class=\"type-card\"\n              :class=\"{ active: fortuneType === 'daily' }\"\n              @click=\"fortuneType = 'daily'\"\n            >\n              <img src=\"/assets/icons/fi_145802.svg\" />\n              รายวัน\n            </div>\n\n            <div\n              class=\"type-card\"\n              :class=\"{ active: fortuneType === 'weekly' }\"\n              @click=\"fortuneType = 'weekly'\"\n            >\n              <img src=\"/assets/icons/fi_145802.svg\" />\n              รายสัปดาห์\n            </div>\n\n            <div\n              class=\"type-card\"\n              :class=\"{ active: fortuneType === 'monthly' }\"\n              @click=\"fortuneType = 'monthly'\"\n            >\n              <img src=\"/assets/icons/fi_145802.svg\" />\n              รายเดือน\n            </div>\n          </div>\n          <div class=\"form-grid\">\n            <template v-if=\"fortuneType === 'daily'\">\n              <div class=\"input-group\">\n                <label>ชื่อ</label>\n                <input type=\"text\" placeholder=\"สมชาย\" />\n              </div>\n\n              <div class=\"input-group\">\n                <label>สกุล</label>\n                <input type=\"text\" placeholder=\"มิตร\" />\n              </div>\n\n              <div class=\"input-group\">\n                <label>วันเดือนปีเกิด</label>\n                <input type=\"date\" />\n              </div>\n\n              <div class=\"input-group\">\n                <label>เวลาที่เกิด</label>\n                <div class=\"time-row\">\n                  <input type=\"number\" placeholder=\"12\" />\n                  <span>:</span>\n                  <input type=\"number\" placeholder=\"00\" />\n                </div>\n              </div>\n            </template>\n\n            <!-- รายสัปดาห์ -->\n            <template v-if=\"fortuneType === 'weekly'\">\n              <div class=\"input-group\">\n                <label>ชื่อ</label>\n                <input type=\"text\" placeholder=\"สมชาย\" />\n              </div>\n\n              <div class=\"input-group\">\n                <label>วันเดือนปีเกิด</label>\n                <input type=\"date\" />\n              </div>\n            </template>\n            <template v-if=\"fortuneType === 'monthly'\">\n              <div class=\"input-group\">\n                <label>ชื่อ</label>\n                <input type=\"text\" placeholder=\"สมชาย\" />\n              </div>\n\n              <div class=\"input-group\">\n                <label>เดือนที่ต้องการดู</label>\n                <input type=\"month\" />\n              </div>\n            </template>\n          </div>\n          <div class=\"note\">\n            *เวลาที่เกิด หากไม่ทราบให้เลือกเวลาประมาณใกล้เคียงที่สุด\n          </div>\n          <button class=\"submit-btn\" @click=\"predict\">ทำนาย</button>\n        </div>\n      </div>\n      <div v-if=\"tab === 'fortune' && showResult\" class=\"result-page\">\n        <div class=\"result-box\">\n          <div class=\"back-btn\" @click=\"goBack\">← ย้อนกลับ</div>\n\n          <div class=\"result-header\">\n            ชื่อ-สกุล : สมชาย มีทรัพย์\n            <br />\n            เกิดวันที่ 20 พฤศจิกายน 2533 เวลา 09:00\n          </div>\n\n          <div class=\"result-content\">\n            <h3>คำทำนายดวง</h3>\n\n            <p>\n              ไพ่ที่คุณได้คือ ไพ่ฤาษี เป็นไพ่แห่งสติปัญญา\n              ช่วงนี้เหมาะกับการวางแผนชีวิตและใช้เหตุผล\n            </p>\n\n            <h3>คำแนะนำการดำเนินชีวิต</h3>\n\n            <p>ช่วงนี้ควรใช้ความรอบคอบและอย่าตัดสินใจเร็วเกินไป</p>\n          </div>\n        </div>\n      </div>\n\n      <div v-if=\"tab === 'tarot'\">\n        <Tarot />\n      </div>\n      <div class=\"news-section\">\n        <div class=\"news-header\">\n          <div>ข่าวหวยใหม่วันนี้</div>\n          <div class=\"view-all\">ดูทั้งหมด</div>\n        </div>\n        <div class=\"home-item\">\n          <ImageCard\n            v-for=\"imgcard in imgcardData\"\n            :key=\"imgcard.id\"\n            :icon=\"'flags/pingpong6.svg'\"\n            :obj=\"imgcard\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\nimport ImageCard from \"~/components/desktop/ImageCard.vue\";\nimport Tarot from \"~/components/desktop/Tarot.vue\";\nconst imgcardData = ref(