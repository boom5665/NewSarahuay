urity */\n\n.security-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n\n.security-card {\n  background: #f5f5f5;\n  border-radius: 8px;\n  padding: 16px;\n  text-align: center;\n}\n\n.security-card .icon {\n  width: 40px;\n  height: 40px;\n  background: #ddd;\n  margin: auto;\n  margin-bottom: 8px;\n}\n\n.security-card .title {\n  font-weight: 600;\n}\n\n.security-card .desc {\n  font-size: 12px;\n  color: #777;\n}\n\n.btn-enable {\n  margin-top: 8px;\n  background: black;\n  color: white;\n  border: none;\n  padding: 6px 12px;\n  border-radius: 6px;\n}\n\n/* session */\n\n.session-list {\n  display: flex;\n  margin-top: 0.75rem;\n  border-radius: 0.5rem;\n  background: #eee;\n  padding: 1rem;\n  gap: 1rem;\n  flex-direction: column;\n}\n\n.session-item {\n  display: flex;\n  align-items: center;\n\n  border-radius: 0.375remp;\n}\n\n.session-item:hover {\n  background: #f5f5f5;\n}\n\n.session-info {\n  flex: 1;\n}\n\n.device {\n  font-weight: 500;\n}\n\n.detail {\n  font-size: 12px;\n  color: #777;\n}\n\n.close {\n  cursor: pointer;\n}\n\n.logout-all {\n  background: black;\n  color: white;\n  border: none;\n  padding: 6px 10px;\n  border-radius: 6px;\n}\n</style>\n","<template>\n  <div class=\"menu-right\">\n    <div class=\"menutop\">{{ $t('Memberlevel') }} <span>{{ $t('pro') }}</span></div>\n\n    <div class=\"grid-box\">\n      <div class=\"section\">\n        <div class=\"section-title\">ตั้งค่าการแจ้งเตือนทั่วไป</div>\n\n        <div class=\"notify-box\">\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" checked />\n            <span class=\"toggle\"></span>\n            รับข้อมูลเกี่ยวกับข้อเสนอพิเศษผ่าน SMS\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle\"></span>\n            รับการแจ้งเตือนภายใน สระ.หวย\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n   