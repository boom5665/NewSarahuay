up\">\n      <div class=\"menu-title\">การตั้งค่าบัญชี </div>\n      <div class=\"menu-group-rof\">\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'account' }\"\n          @click=\"$emit('update:modelValue', 'account')\"\n        >\n          บัญชี\n        </div>\n\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'security' }\"\n          @click=\"$emit('update:modelValue', 'security')\"\n        >\n          ความปลอดภัย\n        </div>\n      </div>\n    </div>\n\n    <div class=\"menu-group\">\n      <div class=\"menu-title\">การตั้งค่าทั่วไป</div>\n      <div class=\"menu-group-rof\">\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'notify' }\"\n          @click=\"$emit('update:modelValue', 'notify')\"\n        >\n          การแจ้งเตือน\n        </div>\n\n        <label class=\"menu-toggle\">\n          <span>โหมดมืด</span>\n\n          <input\n            type=\"checkbox\"\n            :checked=\"darkMode\"\n            @change=\"$emit('update:darkMode', $event.target.checked)\"\n          />\n\n          <span class=\"toggle\"></span>\n        </label>\n\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'activity' }\"\n          @click=\"$emit('update:modelValue', 'activity')\"\n        >\n          บันทึกกิจกรรม\n        </div>\n      </div>\n    </div>\n\n    <div class=\"menu-group\">\n      <div class=\"menu-title\">การตั้งค่า AI</div>\n      <div class=\"menu-group-rof\">\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'ai-stock' }\"\n          @click=\"$emit('update:modelValue', 'ai-stock')\"\n        >\n          AI วิเคราะห์หุ้น\n        </div>\n\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'package' }\"\n          @click=\"$emit('update:modelValue', 'package')\"\n        >\n          แพ็กเกจ & เครดิต\n        </div>\n\n        <div\n          class=\"menu-item\"\n          :class=\"{ active: modelValue === 'ai-history' }\"\n          @click=\"$emit('update:modelValue', 'ai-history')\"\n        >\n          ประวัติการใช้งาน AI\n        </div>\n      </div>\n    </div>\n\n    <div class=\"menu-group logout\">\n      <div class=\"menu-group-rof\">\n        <div class=\"menu-item\">ออกจากระบบ</div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\ndefineProps({\n  modelValue: String,\n  darkMode: Boolean\n});\ndefineEmits([\"update:modelValue\", \"update:darkMode\"]);\n</script>\n\n<style lang=\"scss\" scoped>\n.sidebar {\n  background: #eee;\n  border-radius: 10px;\n  padding: 12px;\n}\n\n.menu-group {\n  margin-bottom: 16px;\n  .menu-group-rof {\n    border-radius: var(--radius-md, 8px);\n    background: #fff;\n    padding: 0.5rem;\n  }\n}\n\n.menu-title {\n  font-size: 13px;\n  color: #888;\n  margin-bottom: 6px;\n}\n\n.menu-item {\n  padding: 10px;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.menu-item:hover {\n  background: #e6e6e6;\n}\n\n.menu-item.active {\n  background: #dedede;\n  font-weight: 600;\n}\n\n.logout .menu-item {\n  color: #c33;\n}\n\n.menu-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.75rem 0.75rem;\n  cursor: pointer;\n}\n\n.menu-toggle input {\n  display: none;\n}\n\n.toggle {\n  width: 38px;\n  height: 20px;\n  background: #ccc;\n  border-radius: 20px;\n  position: relative;\n}\n\n.toggle::after {\n  content: \"\";\n  width: 16px;\n  height: 16px;\n  background: white;\n  border-radius: 50%;\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  transition: 0.2s;\n}\n\n.menu-toggle input:checked + .toggle {\n  background: #000;\n}\n\n.menu-toggle input:checked + .toggle::after {\n  transform: translateX(18px);\n}\n</style>\n","<template>\n  <div class=\"menu-right\">\n    <div class=\"menutop\">{{ $t('Memberlevel') }} <span>{{ $t('pro') }}</span></div>\n    <div class=\"grid-box\">\n      <div class=\"section\">\n        <div class=\"section-title\">บัญชี</div>\n\n        <div class=\"form-grid\">\n          <div class=\"input-group\">\n            <label>ชื่อบัญชี</label>\n            <input type=\"text\" value=\"Sarahuay01\" />\n          </div>\n\n          <div class=\"input-group\">\n            <label>รหัสผ่าน</label>\n            <input type=\"password\" value=\"********\" />\n          </div>\n\n          <div class=\"input-group full\">\n            <label>วันก่อตั้งบัญชี</label>\n            <input type=\"text\" placeholder=\"วว/ดด/ปปปป\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- ข้อมูลส่วนบุคคล -->\n      <div class=\"section\">\n        <div class=\"section-title\">ข้อมูลส่วนบุคคล</div>\n\n        <div class=\"form-grid\">\n          <div class=\"input-group\">\n            <label>ชื่อ</label>\n            <input type=\"text\" placeholder=\"สาระดี\" />\n          </div>\n\n          <div class=\"input-group\">\n            <label>นามสกุล</label>\n            <input type=\"text\" placeholder=\"สาระดี\" />\n          </div>\n\n          <div class=\"input-group\">\n            <label>เพศ</label>\n            <select>\n              <option>ชาย</option>\n              <option>หญิง</option>\n            </select>\n          </div>\n\n          <div class=\"input-group\">\n            <label>วัน/เดือน/ปีเกิด</label>\n            <input type=\"date\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- ติดต่อ -->\n      <div class=\"section full\">\n        <div class=\"section-title\">ติดต่อ</div>\n\n        <div class=\"form-grid\">\n          <div class=\"input-group\">\n            <label>เบอร์โทรศัพท์</label>\n            <input type=\"text\" placeholder=\"000-000-0000\" />\n          </div>\n\n          <div class=\"input-group\">\n            <label>อีเมล</label>\n            <input type=\"email\" placeholder=\"email@email.com\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup></script>\n\n<style lang=\"scss\" scoped>\n.menu-right {\n  border-radius: 0.5rem;\n  background: #e0e0e0;\n}\n\n.grid-box {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1rem;\n  background: #000000;\n  padding: 1rem;\n}\n.menutop {\n  padding-bottom: 0.9063rem;\n  padding-top: 0.9063rem;\n  padding-left: 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  span {\n    border-radius: 0.5rem;\n    background: #fff;\n    padding: 0.25rem 1rem;\n  }\n}\n\n\n.section {\n  background: #fff;\n  border-radius: 8px;\n  padding: 16px;\n}\n\n.section.full {\n  grid-column: span 2;\n}\n\n.section-title {\n  font-weight: 600;\n  margin-bottom: 12px;\n}\n\n/* form grid */\n\n.form-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n\n.input-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.input-group.full {\n  grid-column: span 2;\n}\n\nlabel {\n  font-size: 12px;\n  color: #666;\n  margin-bottom: 4px;\n}\n\ninput,\nselect {\n  padding: 8px 10px;\n  border-radius: 6px;\n  border: 1px solid #ddd;\n  font-size: 14px;\n}\n\n</style>\n","<template>\n  <div class=\"menu-right\">\n    <div class=\"menutop\">{{ $t('Memberlevel') }} <span>{{ $t('pro') }}</span></div>\n\n    <div class=\"grid-box\">\n      <!-- SECURITY -->\n      <div class=\"section\">\n        <div class=\"section-title\">ความปลอดภัย</div>\n\n        <div class=\"security-grid\">\n          <div class=\"security-card\">\n            <div class=\"icon\"></div>\n            <div class=\"title\">เปลี่ยนรหัสผ่าน</div>\n            <div class=\"desc\">เปลี่ยนรหัสผ่านทุกเดือน</div>\n          </div>\n\n          <div class=\"security-card\">\n            <div class=\"icon\"></div>\n            <div class=\"title\">เชื่อมโยงกับโทรศัพท์</div>\n            <div class=\"desc\">ช่วยกู้คืนบัญชีของคุณ</div>\n          </div>\n\n          <div class=\"security-card\">\n            <div class=\"icon\"></div>\n          